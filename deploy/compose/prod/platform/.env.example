# =========================
# APP
# =========================
APP_ENV=production
APP_NAME=tenex
APP_LOG_LEVEL=info


# =========================
# DATABASE
# =========================
DB_HOST=postgres
DB_PORT=5432
DB_USER=tenex
DB_PASS=tenex
DB_NAME=tenex
DB_SSL_MODE=disable


# =========================
# REDIS
# =========================
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0


# =========================
# S3 (MinIO)
# =========================
S3_ENDPOINT=minio:9000
S3_KEY=tenex
S3_SECRET=STRONG_SECRET_HERE
S3_BUCKET=tenex


# =========================
# OBSERVABILITY
# =========================
OTEL_ENDPOINT=otel:4317
LOKI_ENDPOINT=http://loki:3100
METRICS_PORT=9090


# =========================
# CLIENTS
# =========================
TELEGRAM_TOKEN=changeme
# VKONTAKTE_TOKEN=changeme
# WHATSAPP_TOKEN=changeme


# =========================
# SCHEDULER
# =========================
SCHEDULER_MAX_RETRIES=3
SCHEDULER_RETRY_INTERVAL=30


# =========================
# DEPLOY
# =========================
IMAGE_TAG=latest