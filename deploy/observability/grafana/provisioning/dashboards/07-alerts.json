{
  "uid": "tenex-alerts",
  "title": "Tenex — Alerts & Anomalies",
  "description": "Быстрый обзор аномалий: сервисы упавшие, высокий error rate, деградация latency",
  "tags": ["tenex", "alerts"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "🚨 Critical",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Services Down",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "count(up{job=~\"bot|scheduler|worker\"} == 0) or vector(0)",
        "refId": "A"
      }],
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "orientation": "auto" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "mappings": [{ "type": "value", "options": { "0": { "text": "ALL UP", "color": "green" } } }]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "(1 - sum(rate(tenex_updates_total{status=\"ok\"}[5m])) / sum(rate(tenex_updates_total[5m]))) * 100",
        "refId": "A"
      }],
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "P99 Latency (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum by (le) (rate(tenex_update_processing_duration_seconds_bucket[5m])))",
        "refId": "A"
      }],
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Adapter Errors (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(tenex_adapter_errors_total[5m]))", "refId": "A" }],
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Retry Spike (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(tenex_retry_total[5m]))", "refId": "A" }],
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] }
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "High Goroutines",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max(go_goroutines{job=~\"bot|scheduler|worker\"})", "refId": "A" }],
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 700 }] }
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "📈 Trends",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Error Rate Over Time",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "(1 - sum(rate(tenex_updates_total{status=\"ok\"}[2m])) / sum(rate(tenex_updates_total[2m]))) * 100",
        "legendFormat": "Error Rate %",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        }
      },
      "options": { "tooltip": { "mode": "single" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Services Up/Down",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "up{job=\"bot\"}", "legendFormat": "bot", "refId": "A" },
        { "expr": "up{job=\"scheduler\"}", "legendFormat": "scheduler", "refId": "B" },
        { "expr": "up{job=\"worker\"}", "legendFormat": "worker", "refId": "C" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0, "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 30 },
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }]
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "🔴 Recent Errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Last 50 Errors",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "{app=\"tenex\"} | json | level=\"error\" | line_format \"[{{.service}}] {{.msg}} {{if .error}}ERR: {{.error}}{{end}}\"",
        "refId": "A"
      }],
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending" }
    }
  ]
}
