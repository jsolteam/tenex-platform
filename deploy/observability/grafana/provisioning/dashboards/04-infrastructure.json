{
  "uid": "tenex-infra",
  "title": "Tenex — Infrastructure",
  "description": "Go runtime, память, CPU, горутины по каждому сервису",
  "tags": ["tenex", "infrastructure", "golang"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(go_goroutines, job)",
        "query": "label_values(go_goroutines, job)",
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "🖥️ CPU",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU Usage by Service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (job) (rate(process_cpu_seconds_total{job=~\"$job\"}[1m]) * 100)",
        "legendFormat": "{{job}}",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "lineWidth": 2, "fillOpacity": 10 }, "min": 0 } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bot CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(process_cpu_seconds_total{job=\"bot\"}[1m]) * 100)", "refId": "A" }],
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 80 }] }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scheduler CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(process_cpu_seconds_total{job=\"scheduler\"}[1m]) * 100)", "refId": "A" }],
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 80 }] }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Worker CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(process_cpu_seconds_total{job=\"worker\"}[1m]) * 100)", "refId": "A" }],
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 80 }] }
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "💾 Memory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Heap In Use by Service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "go_memstats_heap_inuse_bytes{job=~\"$job\"}",
        "legendFormat": "{{job}}",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Heap Alloc vs Sys",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "go_memstats_alloc_bytes{job=~\"$job\"}",
          "legendFormat": "alloc {{job}}",
          "refId": "A"
        },
        {
          "expr": "go_memstats_sys_bytes{job=~\"$job\"}",
          "legendFormat": "sys {{job}}",
          "refId": "B"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GC Cycles / min",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "rate(go_gc_duration_seconds_count{job=~\"$job\"}[1m]) * 60",
        "legendFormat": "{{job}}",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "GC Pause Duration (p99)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(go_gc_duration_seconds_bucket{job=~\"$job\"}[5m]))",
        "legendFormat": "p99 {{job}}",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 4, "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 11,
      "type": "row",
      "title": "🔀 Goroutines & Threads",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Goroutines by Service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "go_goroutines{job=~\"$job\"}",
        "legendFormat": "{{job}}",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }] }
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "OS Threads by Service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "go_threads{job=~\"$job\"}",
        "legendFormat": "{{job}}",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Bot Goroutines",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "go_goroutines{job=\"bot\"}", "refId": "A" }],
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 35 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 200 }, { "color": "red", "value": 500 }] }
        }
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Scheduler Goroutines",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "go_goroutines{job=\"scheduler\"}", "refId": "A" }],
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 35 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 200 }, { "color": "red", "value": 500 }] }
        }
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Worker Goroutines",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "go_goroutines{job=\"worker\"}", "refId": "A" }],
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 35 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 200 }, { "color": "red", "value": 500 }] }
        }
      }
    },
    {
      "id": 17,
      "type": "row",
      "title": "📦 Process",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "collapsed": false
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Open File Descriptors",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "process_open_fds{job=~\"$job\"}",
        "legendFormat": "{{job}}",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Resident Memory (RSS)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "process_resident_memory_bytes{job=~\"$job\"}",
        "legendFormat": "{{job}}",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    }
  ]
}
