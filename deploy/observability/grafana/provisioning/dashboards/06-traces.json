{
  "uid": "tenex-traces",
  "title": "Tenex — Traces",
  "description": "Анализ трейсов: latency, slow requests, service map",
  "tags": ["tenex", "traces", "tempo"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "🗺️ Service Map",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "nodeGraph",
      "title": "Service Dependency Graph",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{
        "queryType": "serviceMap",
        "refId": "A"
      }],
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 1 }
    },
    {
      "id": 3,
      "type": "row",
      "title": "⏱️ Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "collapsed": false
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request Rate (from traces)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (service_name) (rate(traces_spanmetrics_calls_total[1m]))",
        "legendFormat": "{{service_name}}",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency Percentiles (from traces)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, service_name) (rate(traces_spanmetrics_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p50 {{service_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_spanmetrics_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95 {{service_name}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(traces_spanmetrics_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p99 {{service_name}}",
          "refId": "C"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 6,
      "type": "row",
      "title": "🔍 Trace Search",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "traces",
      "title": "Recent Traces",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{
        "queryType": "traceql",
        "query": "{ .service.name = \"tenex\" }",
        "limit": 20,
        "refId": "A"
      }],
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 23 }
    },
    {
      "id": 8,
      "type": "traces",
      "title": "Slow Traces (> 1s)",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{
        "queryType": "traceql",
        "query": "{ .service.name = \"tenex\" && duration > 1s }",
        "limit": 20,
        "refId": "A"
      }],
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 35 }
    },
    {
      "id": 9,
      "type": "traces",
      "title": "Error Traces",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{
        "queryType": "traceql",
        "query": "{ .service.name = \"tenex\" && status = error }",
        "limit": 20,
        "refId": "A"
      }],
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 47 }
    }
  ]
}
